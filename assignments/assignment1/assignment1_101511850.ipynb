# String
gym_member = "Alex Alliton"     
# String
preferred_weight_kg = 20.5
# Integer
highest_reps = 25
#Boolean
membership_active = True


print(gym_member)
print(preferred_weight_kg)
print(highest_reps)
print(membership_active)

# Dictionary: Keys contain the names (strings), Values contain tuples that have minutes (integers)
workout_stats = {
    "Alex": (30, 45, 50),
    "Jamie": (55, 50, 30),
    "Taylor": (40, 35, 25)
}

total_workout = {}

for member, minutes in workout_stats.items():
    total_minutes = sum(minutes)
    total_workout[member + "_total_workout"] = total_minutes
    print(total_minutes)

workout_stats.update(total_workout)
print(workout_stats)
print(total_workout)

# Data type: list of lists of integers, each inner list contains integers representing the minutes spent on each activity 
workout_list = []
for member, activity in workout_stats.items():
    if not member.endswith("_total_workout"):
        workout_list.append(list(activity))

print("Yoga and Running Minutes:")
for row in workout_list:
    yoga, running, *_ = row
    print([yoga, running])
print()

print("Weightlifting Minutes for Last Two Friends:")
for row in workout_list[-2:]:
    *_, weightlifting = row
    print(weightlifting)
print()


for member, total_minutes in workout_stats.items():
    if member.endswith("_total_workout") and total_minutes >= 120:
        name = member.replace("_total_workout", "")
        print(f"Great job {name}, Keep it up!")

member_name = input("Enter the member name: ")

if (activity_minutes := workout_stats.get(member_name)) is not None:
    yoga, running, weightlifting = activity_minutes
    print(f"{member_name}'s workout per session: Yoga: {yoga} mins, Running: {running} mins, Weightlifting: {weightlifting} mins")
    print(f"Total workout time for {member_name}: {sum(activity_minutes)} mins")
else:
    print(f"{member_name} is not found in the system.")



# Find the member with the highest and lowest total workout minutes by iterating over the dictionary
max_member = min_member = list(total_workout.items())[0]
for member, minutes in total_workout.items():
    if minutes > max_member[1]:
        max_member = (member, minutes)
    elif minutes < min_member[1]:
        min_member = (member, minutes)

# Output results
print(f"Top performer: {max_member[0].replace('_total_workout', '')} with {max_member[1]} mins")
print(f"Lowest workout: {min_member[0].replace('_total_workout', '')} with {min_member[1]} mins")


 